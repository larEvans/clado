// This Pine Script was auto-generated by the Claude Trading Bot
// Indicator: Options Overlay — Expected Move + ATM Strike Reference
// Add this ON TOP OF the ORB or VWAP strategy chart
// It labels signals as CALL or PUT and draws ±1σ expected move bands
//@version=5
indicator("Options Overlay — EM Bands + ATM Strikes", overlay=true, max_labels_count=500)

// ─── Inputs ──────────────────────────────────────────────────────────────────
grp1         = "Expected Move"
iv           = input.float(15.0, "Implied Volatility %",   minval=1, maxval=300, group=grp1) / 100
dte          = input.int(7,      "Target DTE",             minval=0, maxval=90,  group=grp1)
showEM       = input.bool(true,  "Show EM bands",                                group=grp1)

grp2         = "Strikes"
interval     = input.float(1.0, "Strike Interval ($)",    minval=0.5, maxval=25, step=0.5, group=grp2)
showStrikes  = input.bool(true, "Show ATM call/put strike lines", group=grp2)
numStrikes   = input.int(3, "Strikes above/below ATM",  minval=1, maxval=10, group=grp2)

grp3         = "Signal Labels"
orbLabel     = input.bool(true, "Label ORB breakout signals C/P", group=grp3)
vwapLabel    = input.bool(true, "Label VWAP signals C/P",         group=grp3)

// ─── Expected Move ────────────────────────────────────────────────────────────
em   = close * iv * math.sqrt(dte / 365.0)
emUp = close + em
emDn = close - em

emUpPlot = showEM ? emUp : na
emDnPlot = showEM ? emDn : na

plot(emUpPlot, "+1σ EM",  color.new(color.teal,  60), 1, plot.style_linebr)
plot(emDnPlot, "-1σ EM",  color.new(color.orange,60), 1, plot.style_linebr)

// Fill between EM bands
emUpLine = plot(showEM ? emUp : na, display=display.none)
emDnLine = plot(showEM ? emDn : na, display=display.none)
fill(emUpLine, emDnLine, color.new(color.blue, 93), title="EM Fill")

// ─── ATM Strike Grid ──────────────────────────────────────────────────────────
// Round current price to nearest strike interval
atmCall = math.ceil(close / interval)  * interval
atmPut  = math.floor(close / interval) * interval

// Draw N strikes above (calls) and below (puts)
// Using arrays of horizontal lines (drawn dynamically each bar would repaint — use barstate.islast)
var label[] emCallLabels = array.new<label>()
var label[] emPutLabels  = array.new<label>()
var line[]  strikeLines  = array.new<line>()

if barstate.islast and showStrikes
    // Clean up previous labels and lines
    for lb in emCallLabels  label.delete(lb)
    for lb in emPutLabels   label.delete(lb)
    for ln in strikeLines   line.delete(ln)
    array.clear(emCallLabels)
    array.clear(emPutLabels)
    array.clear(strikeLines)

    // Draw call strikes above
    for i = 0 to numStrikes - 1
        s = atmCall + i * interval
        ln = line.new(bar_index - 20, s, bar_index, s, color=color.new(color.green, 70), width=1, style=line.style_dotted)
        lb = label.new(bar_index, s, "C " + str.tostring(s, "#.##"), color=color.new(color.green, 20), textcolor=color.white, style=label.style_label_left, size=size.tiny)
        array.push(strikeLines, ln)
        array.push(emCallLabels, lb)

    // Draw put strikes below
    for i = 0 to numStrikes - 1
        s = atmPut - i * interval
        ln = line.new(bar_index - 20, s, bar_index, s, color=color.new(color.red, 70), width=1, style=line.style_dotted)
        lb = label.new(bar_index, s, "P " + str.tostring(s, "#.##"), color=color.new(color.red, 20), textcolor=color.white, style=label.style_label_left, size=size.tiny)
        array.push(strikeLines, ln)
        array.push(emPutLabels, lb)

// ─── Signal detection (matches ORB and VWAP Pine Scripts) ─────────────────────
isSession = not na(time("1", "0930-1600", "America/New_York"))
vwapLine  = ta.vwap(hlc3)
ema8      = ta.ema(close, 8)
rsi3      = ta.rsi(close, 3)

bullish = close > vwapLine and close > ema8
bearish = close < vwapLine and close < ema8

// VWAP signals
vwapLong  = vwapLabel and bullish and rsi3 < 30 and math.abs((close - vwapLine)/vwapLine)*100 < 1.5
vwapShort = vwapLabel and bearish and rsi3 > 70 and math.abs((close - vwapLine)/vwapLine)*100 < 1.5

// ORB: detect session and price range (simplified detection)
var float orbH = na
var float orbL = na
var bool  orbSet = false
newSess = isSession and not isSession[1]
if newSess
    orbH := high; orbL := low; orbSet := false
if isSession and not orbSet
    if (time - time[1]) <= 16 * 60 * 1000  // within first 15m (rough)
        orbH := math.max(orbH, high)
        orbL := math.min(orbL, low)
    else
        orbSet := true

orbLong  = orbLabel and orbSet and isSession and close > orbH and close > vwapLine
orbShort = orbLabel and orbSet and isSession and close < orbL and close < vwapLine

// ─── Signal labels ────────────────────────────────────────────────────────────
longSig  = (vwapLong  and not vwapLong[1])  or (orbLong  and not orbLong[1])
shortSig = (vwapShort and not vwapShort[1]) or (orbShort and not orbShort[1])

if longSig
    label.new(bar_index, low  - em * 0.1, "BUY CALL\n" + str.tostring(math.ceil(close/interval)*interval, "#.##") + "C",
      color=color.new(color.green, 10), textcolor=color.white, style=label.style_label_up, size=size.small)

if shortSig
    label.new(bar_index, high + em * 0.1, "BUY PUT\n" + str.tostring(math.floor(close/interval)*interval, "#.##") + "P",
      color=color.new(color.red, 10), textcolor=color.white, style=label.style_label_down, size=size.small)

// ─── Info box ─────────────────────────────────────────────────────────────────
if barstate.islast
    emPct = em / close * 100
    infoText = "IV: " + str.tostring(iv * 100, "#.#") + "%" +
               "\nDTE: " + str.tostring(dte) +
               "\nEM: ±$" + str.tostring(math.round(em, 2)) + " (" + str.tostring(math.round(emPct, 1)) + "%)" +
               "\nATM C: " + str.tostring(atmCall, "#.##") +
               "\nATM P: " + str.tostring(atmPut, "#.##")
    table t = table.new(position.top_right, 1, 1, bgcolor=color.new(color.navy, 20), border_color=color.new(color.white, 60), border_width=1)
    table.cell(t, 0, 0, infoText, text_color=color.white, text_size=size.small)
