// This Pine Script was auto-generated by the Claude Trading Bot
// Strategy: Opening Range Breakout (ORB)
// Matches bot logic in strategies/orb.js
//@version=5
strategy("ORB — Opening Range Breakout", overlay=true,
  default_qty_type=strategy.percent_of_equity, default_qty_value=10,
  commission_type=strategy.commission.percent, commission_value=0.05,
  initial_capital=10000)

// ─── Inputs ──────────────────────────────────────────────────────────────────
grp1         = "Opening Range"
orbMinutes   = input.int(15,   "ORB Window (minutes)",      minval=5,  maxval=60,  group=grp1)
maxRangePct  = input.float(1.0,"Max Range % of Price",      minval=0.1,maxval=5.0, group=grp1, step=0.1)

grp2         = "Trade Rules"
rrRatio      = input.float(2.0,"R:R Target Ratio",          minval=1.0,maxval=5.0, group=grp2, step=0.5)
cutoffHour   = input.int(11,   "Trade Cutoff Hour (ET)",    minval=9,  maxval=15,  group=grp2)

grp3         = "Volume Filter"
volMult      = input.float(2.0,"Volume Multiplier",         minval=1.0,maxval=5.0, group=grp3, step=0.5)
volMaPer     = input.int(20,   "Volume MA Period",          minval=5,  maxval=50,  group=grp3)

// ─── Session & time helpers ───────────────────────────────────────────────────
isSession    = not na(time("1", "0930-1600", "America/New_York"))
etHour       = hour(time, "America/New_York")
etMinute     = minute(time, "America/New_York")
isAfterCutoff = etHour >= cutoffHour

newSession   = isSession and not isSession[1]

// ─── ORB state (reset each session) ──────────────────────────────────────────
var float orbHigh    = na
var float orbLow     = na
var bool  orbLocked  = false
var bool  tradeDone  = false
var int   orbBarEnd  = na

if newSession
    orbHigh   := high
    orbLow    := low
    orbLocked := false
    tradeDone := false
    orbBarEnd := bar_index + orbMinutes - 1

if isSession and not orbLocked
    orbHigh := math.max(orbHigh, high)
    orbLow  := math.min(orbLow,  low)
    if bar_index >= orbBarEnd
        orbLocked := true

// ─── Indicators ───────────────────────────────────────────────────────────────
vwapVal  = ta.vwap(hlc3)
volMA    = ta.sma(volume, volMaPer)
highVol  = volume >= volMA * volMult

// ─── Derived levels ───────────────────────────────────────────────────────────
orbRange    = not na(orbHigh) and not na(orbLow) ? orbHigh - orbLow : na
longTarget  = not na(orbRange) ? orbHigh + orbRange * rrRatio  : na
shortTarget = not na(orbRange) ? orbLow  - orbRange * rrRatio  : na
rangePct    = not na(orbRange) and close > 0 ? (orbRange / close) * 100 : na
rangeOk     = not na(rangePct) and rangePct < maxRangePct

// ─── Entry conditions ─────────────────────────────────────────────────────────
canTrade    = orbLocked and isSession and not isAfterCutoff and rangeOk and not tradeDone

longEntry   = canTrade and ta.crossover(close, orbHigh)  and close > vwapVal and highVol
shortEntry  = canTrade and ta.crossunder(close, orbLow)  and close < vwapVal and highVol

// ─── Entries & exits ──────────────────────────────────────────────────────────
if longEntry
    strategy.entry("ORB Long", strategy.long)
    strategy.exit("ORB Long X", "ORB Long", stop=orbLow, limit=longTarget, comment_loss="SL", comment_profit="TP")
    tradeDone := true

if shortEntry
    strategy.entry("ORB Short", strategy.short)
    strategy.exit("ORB Short X", "ORB Short", stop=orbHigh, limit=shortTarget, comment_loss="SL", comment_profit="TP")
    tradeDone := true

// Time stop at 3:45 PM ET
timeStop = isSession and etHour == 15 and etMinute >= 45
if timeStop
    strategy.close_all("Time Stop")

// ─── Plots ────────────────────────────────────────────────────────────────────
orbHighPlot  = isSession and not na(orbHigh)  ? orbHigh  : na
orbLowPlot   = isSession and not na(orbLow)   ? orbLow   : na
longTgtPlot  = isSession and not na(longTarget)  ? longTarget  : na
shortTgtPlot = isSession and not na(shortTarget) ? shortTarget : na

plot(orbHighPlot,  "ORB High",      color.new(color.green, 0),  2, plot.style_linebr)
plot(orbLowPlot,   "ORB Low",       color.new(color.red,   0),  2, plot.style_linebr)
plot(longTgtPlot,  "Long Target",   color.new(color.lime,  50), 1, plot.style_linebr)
plot(shortTgtPlot, "Short Target",  color.new(color.orange,50), 1, plot.style_linebr)
plot(vwapVal,      "VWAP",          color.new(color.blue,  0),  2)

// Signal shapes
plotshape(longEntry,  "Long Signal",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(shortEntry, "Short Signal", shape.triangledown, location.abovebar, color.red,   size=size.small)

// ORB window background
bgcolor(isSession and not orbLocked and not na(orbHigh) ? color.new(color.yellow, 92) : na, title="ORB Window")
