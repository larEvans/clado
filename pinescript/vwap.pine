// This Pine Script was auto-generated by the Claude Trading Bot
// Strategy: VWAP + EMA Momentum
// Matches bot logic in strategies/vwap.js
//@version=5
strategy("VWAP + EMA Momentum", overlay=true,
  default_qty_type=strategy.percent_of_equity, default_qty_value=10,
  commission_type=strategy.commission.percent, commission_value=0.05,
  initial_capital=10000)

// ─── Inputs ──────────────────────────────────────────────────────────────────
grp1         = "Indicators"
emaPeriod    = input.int(8,   "EMA Period",           minval=1, maxval=50,  group=grp1)
rsiPeriod    = input.int(3,   "RSI Period",           minval=1, maxval=20,  group=grp1)

grp2         = "Entry Filters"
rsiOB        = input.int(70,  "RSI Overbought",       minval=55, maxval=95, group=grp2)
rsiOS        = input.int(30,  "RSI Oversold",         minval=5,  maxval=45, group=grp2)
maxDist      = input.float(1.5,"Max VWAP Dist %",     minval=0.1,maxval=5.0,group=grp2, step=0.1)

grp3         = "Risk"
rrRatio      = input.float(2.0,"R:R Target Ratio",    minval=1.0,maxval=5.0,group=grp3, step=0.5)
stopPct      = input.float(1.5,"Stop % from VWAP",    minval=0.1,maxval=5.0,group=grp3, step=0.1)

// ─── Indicators ──────────────────────────────────────────────────────────────
ema8     = ta.ema(close, emaPeriod)
vwapVal  = ta.vwap(hlc3)
rsi3     = ta.rsi(close, rsiPeriod)

distPct  = math.abs((close - vwapVal) / vwapVal) * 100
notOver  = distPct < maxDist

// ─── Bias ────────────────────────────────────────────────────────────────────
bullish  = close > vwapVal and close > ema8
bearish  = close < vwapVal and close < ema8

// ─── Stop & target ───────────────────────────────────────────────────────────
stopDist     = vwapVal * (stopPct / 100)
longStop     = vwapVal - stopDist
shortStop    = vwapVal + stopDist
longTarget   = close + (close - longStop)  * rrRatio
shortTarget  = close - (shortStop - close) * rrRatio

// ─── Signals ─────────────────────────────────────────────────────────────────
longSig  = bullish and rsi3 < rsiOS and notOver and strategy.position_size == 0
shortSig = bearish and rsi3 > rsiOB and notOver and strategy.position_size == 0

// ─── Strategy ────────────────────────────────────────────────────────────────
if longSig
    strategy.entry("VWAP Long", strategy.long)
    strategy.exit("VWAP Long X", "VWAP Long", stop=longStop, limit=longTarget)

if shortSig
    strategy.entry("VWAP Short", strategy.short)
    strategy.exit("VWAP Short X", "VWAP Short", stop=shortStop, limit=shortTarget)

// Exit on bias flip
if strategy.position_size > 0 and bearish
    strategy.close("VWAP Long", comment="Bias Flip")
if strategy.position_size < 0 and bullish
    strategy.close("VWAP Short", comment="Bias Flip")

// ─── Plots ────────────────────────────────────────────────────────────────────
plot(ema8,    "EMA 8", color.new(color.orange, 0), 2)
plot(vwapVal, "VWAP",  color.new(color.blue,   0), 2)

// Bias background
bgcolor(bullish ? color.new(color.green, 94) : bearish ? color.new(color.red, 94) : na, title="Bias")

// Signal shapes
plotshape(longSig,  "Long",  shape.triangleup,   location.belowbar, color.green, size=size.small)
plotshape(shortSig, "Short", shape.triangledown, location.abovebar, color.red,   size=size.small)

// RSI panel
rsiPlot = plot(rsi3, "RSI(3)", color.new(color.purple, 0), 2, display=display.pane)
hline(rsiOB, "OB",  color.new(color.red,   50), hline.style_dashed)
hline(rsiOS, "OS",  color.new(color.green, 50), hline.style_dashed)
hline(50,    "Mid", color.new(color.gray,  70), hline.style_dotted)
