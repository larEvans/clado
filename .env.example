# ── Exchange selector ────────────────────────────────────────────────────────
# Options: alpaca | bitget | webull
EXCHANGE=alpaca

# ── Alpaca credentials (used when EXCHANGE=alpaca) ───────────────────────────
# Sign up at alpaca.markets → Paper Trading → API Keys
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
# Alpaca account URL. Keep paper URL for paper-account orders; switch to live URL for live brokerage orders.
# Paper: https://paper-api.alpaca.markets
# Live:  https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Webull credentials (used when EXCHANGE=webull) ───────────────────────────
WEBULL_EMAIL=your@email.com
WEBULL_PASSWORD=yourpassword
WEBULL_TRADING_PIN=123456

# ── BitGet credentials (used when EXCHANGE=bitget) ───────────────────────────
BITGET_API_KEY=your_api_key_here
BITGET_SECRET_KEY=your_secret_key_here
BITGET_PASSPHRASE=your_passphrase_here
BITGET_BASE_URL=https://api.bitget.com

# ── State storage ────────────────────────────────────────────────────────────
# Where runtime state lives: trade history, learned params, bot config/state,
# trades.csv, safety-check log. Defaults to the repo directory. On Railway,
# attach a volume and point this at the mount path so learning and trade
# history survive redeploys.
# DATA_DIR=/data

# ── Dashboard ────────────────────────────────────────────────────────────────
# Required in any deployment reachable from the internet (Railway, VPS).
# Protects all dashboard pages and /api/* endpoints. Open the dashboard once
# as https://your-app/?token=YOUR_TOKEN (sets a cookie), or send the
# x-dashboard-token header from API clients. Leave empty to run unprotected
# (local use only).
DASHBOARD_TOKEN=

# ── Trading config ────────────────────────────────────────────────────────────
# Alpaca/Webull: stock tickers (SPY, QQQ, AAPL)
# BitGet: crypto pairs (BTCUSDT, ETHUSDT)
SYMBOL=SPY
TIMEFRAME=1H
TRADE_MODE=spot
PORTFOLIO_VALUE_USD=1000
MAX_TRADE_SIZE_USD=100
MAX_TRADES_PER_DAY=3

# Daily loss kill switch (streaming bot). When the day's realized P&L across
# all closed trades reaches -N%, the bot stops opening new positions until the
# next trading day (exits still process). 0 = disabled. Recommended: 5
MAX_DAILY_LOSS_PCT=5

# Router starts enabled by default so the streaming bot trades as soon as it starts.
# Set to false to start in single-symbol mode instead.
ROUTER_ENABLED=true

# true = bot logs decisions but sends nothing to Alpaca
# false = bot submits Alpaca orders to ALPACA_BASE_URL
# Examples accepted by the bot: false, FALSE, 0, no, off
PAPER_TRADING=true

# ── Options trading (EXCHANGE=alpaca only) ────────────────────────────────────
# TRADE_TYPE=stock  → buy/sell shares (default)
# TRADE_TYPE=options → buy ATM call (long signal) or put (short signal) instead
TRADE_TYPE=stock
OPTIONS_DTE=7             # target days to expiration
OPTIONS_MAX_PREMIUM=500   # max premium per trade in USD (1 contract = 100 shares × premium)
OPTIONS_CONTRACTS=1       # number of contracts to buy

# ── Price-target model — the "4th brain" (XGBoost predictor) ──────────────────
# A supervised model (NOT an LLM) that forecasts each symbol's forward return
# and turns it into a price target + horizon + confidence. Off by default:
# with it off, the dashboard Screener tab still works in advisory mode.
# See ml/README.md for the offline training workflow.
PREDICTOR_ENABLED=false        # gate/size router entries with the model
PREDICTOR_MIN_CONFIDENCE=0.5   # below this the model won't veto a signal
PREDICTOR_VETO=true            # skip trades the model confidently disagrees with
PREDICTOR_SIZE_SCALING=true    # scale position size by model confidence (0.5x–1.25x)
# PREDICTOR_MODEL_PATH=/data/model.json   # explicit model location (else DATA_DIR then ml/)
PREDICTOR_HORIZON_BARS=12      # label/forecast horizon in bars (training + metadata)
PREDICTOR_BAR_MINUTES=5        # bar size, to convert horizon bars → days for options DTE
PREDICTOR_HORIZON_DAYS=5       # fallback horizon when the model omits one
PREDICTOR_INTERVAL=5m          # bar interval the screener/exporter fetch
PREDICTOR_SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMD,META   # default training universe
